{
	"name": "hyperschoolenrollment",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node --env-file-if-exists=.env build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker && node scripts/guard-svelte5.mjs",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"guard": "node scripts/guard-svelte5.mjs",
		"budget": "node scripts/budget.mjs",
		"test:e2e": "node scripts/e2e.mjs",
		"verify": "npm run check && npm run build && npm run budget && npm run test:e2e",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
		"db:seed": "node --env-file-if-exists=.env scripts/seed.mjs",
		"db:studio": "drizzle-kit studio",
		"staff": "node --env-file-if-exists=.env --experimental-strip-types --disable-warning=ExperimentalWarning scripts/staff.ts"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"better-sqlite3": "13.0.3"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "6.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/better-sqlite3": "9.6.0",
		"@types/node": "22.20.5",
		"drizzle-kit": "0.31.11",
		"drizzle-orm": "0.45.4",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"typescript": "6.0.3",
		"vite": "8.3.4"
	}
}
