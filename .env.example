# Copy to .env. Declared and validated in src/env.ts.

# SQLite file (directory is created if missing). Put it on the NVMe, back it up with Litestream/restic.
DATABASE_URL=data/enrollment.db
UPLOAD_DIR=data/uploads

# Bearer tokens (≥32 chars, comma-separated) for school-wide systems calling /api/v1.
# Empty = API returns 404. Generate: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
INTEGRATION_TOKENS=

# Static: baked in at build time.
PUBLIC_SCHOOL_NAME=San Pascual Polytechnic College

# adapter-node runtime settings
PORT=3000
HOST=127.0.0.1
# Behind Caddy: trust its forwarded headers (only because Caddy is the sole entry point).
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1
# Room for a few compressed document photos per request.
BODY_SIZE_LIMIT=2M
